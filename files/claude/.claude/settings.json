{
  "respectGitignore": true,
  "cleanupPeriodDays": 200,
  "env": {
    "CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT": "4600000"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(pnpm:*)",
      "Bash(sed:*)",
      "Bash(npm:*)",
      "Bash(./mvnw:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EndConversation",
      "EnterWorktree",
      "ExitWorktree",
      "LSP",
      "Monitor",
      "ShareOnboardingGuide",
      "TaskOutput",
      "TaskStop",
      "Agent",
      "ListAgents",
      "SendMessage",
      "WebFetch",
      "WebSearch",
      "Skill"
    ]
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {},
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "disableSideloadFlags": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "disableMobileSimulatorTools": true,
  "browserExternalPageTools": "disabled",
  "disableBrowserExternalNavigation": true,
  "workflowKeywordTriggerEnabled": false
}

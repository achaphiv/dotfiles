#!/usr/bin/env bash

set -euo pipefail

if (( $# == 1 )) && [[ $1 == --help ]]; then
  cat <<'HELP'
usage: h-review-this-branch
       h-review-this-branch --help

Trigger a new agent to review this branch
HELP
  exit 0
fi

if (( $# != 0 )); then
  printf 'usage: h-review-this-branch\n' >&2
  exit 64
fi

mkdir -p "$HOME/tmp/"

# The agent inherits SHELL from the pane shell. Pinning bash keeps both off fish, whose
# quoting rules differ enough to mangle prompts.
pane_json=$(herdr pane split "$HERDR_PANE_ID" \
  --direction right \
  --cwd "$PWD" \
  --no-focus \
  --env SHELL=/bin/bash \
  --env "TMPDIR=$HOME/tmp/")

pane_id=$(jq -er '.result.pane.pane_id' <<<"$pane_json")

prompt='
  Create 3 distinct prompts that each:

  - read-only adversarial review on this branch
  - write result to temp file

  Store the generated prompts in shell variables and pass quoted expansions; do not paste
  prompt text directly into a shell command:

  `h-review-3 "$prompt_1" "$prompt_2" "$prompt_3"`

  Wait for all reviews. Read/delete each review; assess feedback, do not apply
  blindly.

  Substantive: bugs, behavior, security, data integrity, compatibility, material performance,
  failed tests, unmet acceptance criteria.

  Minor: docs/comments, style, naming, formatting, optional refactors, behavior-neutral cleanup.

  Only minor issues? Make no changes; rebase `main`. If no-op/no conflicts, run
  `notify-done-sound` and stop here.

  Any substantive finding, or rebase failure? Fix and commit. Prefer rewriting history where possible.

  Finally, run `h-review-this-branch` and stop.
'

# exec h-agent-run "feedback-$RANDOM" "$pane_id" claude "$prompt" --dangerously-skip-permissions --system-prompt ''
h-agent-run "feedback-$RANDOM" "$pane_id" pi "$prompt" --model openai-codex/gpt-5.6-luna:max

sleep 1

herdr pane close "$HERDR_PANE_ID"

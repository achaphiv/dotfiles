#!/usr/bin/env bash

set -euo pipefail

if (( $# == 1 )) && [[ $1 == --help ]]; then
  cat <<'HELP'
usage: h-review-this-branch
       h-review-this-branch --help

Trigger a new agent to review this branch
HELP
  exit 0
fi

if (( $# != 0 )); then
  printf 'usage: h-review-this-branch\n' >&2
  exit 64
fi

prompt='
  Recursive review/fix pass; converge and stop when progress stalls.

  State file: `~/tmp/${HERDR_WORKSPACE_ID}/state.md`.

  Read/update it
  each round; never delete it. Store the problem summary, round, prior/current verified-NEW
  finding counts, scope of changes, and fixes.

  Launch 2 read-only adversarial review subagents in parallel to analyze this branch
  and search for substantive changes. Restrict the scope of the analysis to changed
  commits.

  Substantive: bugs, security, data integrity, compatibility, material
  performance, failed tests, or unmet acceptance criteria.

  Minor: docs, style, naming, formatting, or behavior-neutral cleanup.

  Wait for and read all reports, then deduplicate them. Findings must be
  concrete, reproducible, and branch-introduced. Label each NEW, DUPLICATE,
  ALREADY_FIXED, SPECULATIVE, or MINOR.

  Count only verified NEW substantive findings. Fix and commit only those;
  run relevant tests/builds, then update the state file. Delete reports only
  after recording the summary.

  Recurse only when no prior round is recorded in
  the state file, or when this round made changes.

  - If recurse: run `h-review-this-branch`
  - Else: run `h-review-done`
'

# The agent inherits SHELL from the pane shell. Pinning bash keeps both off fish, whose
# quoting rules differ enough to mangle prompts.
pane_json=$(herdr pane split "$HERDR_PANE_ID" \
  --direction right \
  --cwd "$PWD" \
  --no-focus \
  --env SHELL=/bin/bash \
  --env "TMPDIR=$HOME/tmp/")

pane_id=$(jq -er '.result.pane.pane_id' <<<"$pane_json")

#h-agent-run "feedback-$RANDOM" "$pane_id" claude "$prompt" --dangerously-skip-permissions --system-prompt ''
h-agent-run "feedback-$RANDOM" "$pane_id" pi "$prompt" --model openai-codex/gpt-5.6-luna:xhigh

sleep 3

herdr pane close "$HERDR_PANE_ID"

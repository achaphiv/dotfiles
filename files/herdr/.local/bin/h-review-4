#!/usr/bin/env bash

set -euo pipefail

# One entry per reviewer. `parents` indexes an earlier reviewer's pane and is unused for
# reviewer 0, which takes the reviews tab's root pane; `directions` is the split direction off
# that parent. Editing these arrays changes the fan-out and the agent mix.
kinds=(claude claude pi pi)
parents=(0 0 0 1)
directions=('' right down down)

count=${#kinds[@]}

if (( $# != count )); then
  printf 'usage: h-review-4 PROMPT1..PROMPT%d\n' "$count" >&2
  exit 64
fi

prompts=("$@")

# An open-ended prompt can outrun any fixed deadline; raise this rather than lose the run.
timeout_ms="${H_REVIEW_TIMEOUT_MS:-7200000}"
timeout_minutes=$(( timeout_ms / 60000 ))

pane_tmpdir() {
  printf '%s' "$HOME/tmp/$(( $1 + 1 ))"
}

# Each pane gets its own TMPDIR so concurrent agents cannot collide on temp files; the
# directories have to exist before the tab and the splits below inherit them.
for ((i = 0; i < count; i++)); do
  mkdir -p "$(pane_tmpdir "$i")"
done

# Sets `options` for one agent kind. Kept apart from the table so the table stays a list of
# kinds, and so a kind can be swapped in there without touching its flags.
set_agent_options() {
  case "$1" in
    claude)
      options=(--model opus --effort medium --dangerously-skip-permissions --system-prompt '')
      ;;
    pi)
      options=(--model openai-codex/gpt-5.6-luna:max)
      ;;
    codex)
      options=(--yolo --model gpt-5.6-luna -c 'model_reasoning_effort="max"')
      ;;
    *)
      printf 'h-review-4: unsupported agent kind: %s\n' "$1" >&2
      return 64
      ;;
  esac
}

tabs_json="$(herdr tab list --workspace "$HERDR_WORKSPACE_ID")"
review_tab_id="$(jq -r --arg label reviews \
  'first(.result.tabs[]? | select(.label == $label) | .tab_id) // empty' \
  <<<"$tabs_json")"

if [[ -n "$review_tab_id" ]]; then
  panes_json="$(herdr pane list --workspace "$HERDR_WORKSPACE_ID")"
  mapfile -t old_panes < <(
    jq -r --arg tab_id "$review_tab_id" \
      '.result.panes[]? | select(.tab_id == $tab_id) | .pane_id' \
      <<<"$panes_json"
  )
  if (( ${#old_panes[@]} == 0 )); then
    printf 'h-review-4: reviews tab has no panes\n' >&2
    exit 1
  fi

  # Keep one replacement pane alive while the old panes are closed.
  root_json="$(herdr pane split "${old_panes[0]}" \
    --direction right \
    --cwd "$PWD" \
    --no-focus \
    --env SHELL=/bin/bash \
    --env TMPDIR="$(pane_tmpdir 0)")"
  panes=("$(jq -er '.result.pane.pane_id' <<<"$root_json")")

  for pane in "${old_panes[@]}"; do
    herdr pane close "$pane" >/dev/null
  done
else
  tab_json="$(herdr tab create \
    --workspace "$HERDR_WORKSPACE_ID" \
    --cwd "$PWD" \
    --label reviews \
    --no-focus \
    --env SHELL=/bin/bash \
    --env TMPDIR="$(pane_tmpdir 0)")"
  panes=("$(jq -er '.result.root_pane.pane_id' <<<"$tab_json")")
fi

for ((i = 1; i < count; i++)); do
  split_json="$(herdr pane split "${panes[${parents[$i]}]}" \
    --direction "${directions[$i]}" \
    --cwd "$PWD" \
    --no-focus \
    --env SHELL=/bin/bash \
    --env TMPDIR="$(pane_tmpdir "$i")")"
  panes+=("$(jq -er '.result.pane.pane_id' <<<"$split_json")")
done

agent_run_id="$RANDOM"
names=()
for ((i = 0; i < count; i++)); do
  names+=("agent-$(( i + 1 ))-${agent_run_id}")
done

for ((i = 0; i < count; i++)); do
  set_agent_options "${kinds[$i]}"
  h-agent-start "${names[$i]}" "${panes[$i]}" "${kinds[$i]}" "${options[@]}"
done

# Submit through h-agent-prompt instead of `agent prompt --wait`: a review agent can swallow a
# large paste just as a main agent can, and a prompt that never landed leaves the agent idle,
# which a settle wait reports as a finished review. Splitting submit from wait costs the
# state-change guard built into `--wait`, so wait for `working` first; an agent that finished
# its whole turn inside that window simply times out here and matches idle below.
prompt_pids=()
for ((i = 0; i < count; i++)); do
  (
    h-agent-prompt "${names[$i]}" "${panes[$i]}" "${prompts[$i]}" || exit 2
    herdr agent wait "${names[$i]}" --until working --timeout 15000 >/dev/null 2>&1 || true
    herdr agent wait "${names[$i]}" --timeout "$timeout_ms" >/dev/null
  ) &
  prompt_pids+=("$!")
done

echo "Agents started. Now waiting up to ${timeout_minutes} minutes for completion."

# A laggard must never discard the reviews that did finish, so record each outcome and report
# them all. The panes stay alive either way, so even an unsettled agent is still readable.
prompt_failed=0
settled=()
for ((i = 0; i < count; i++)); do
  status=0
  wait "${prompt_pids[$i]}" || status=$?

  case "$status" in
    0)
      settled+=("finished")
      ;;
    2)
      settled+=("PROMPT NEVER ECHOED -- see the error above; nothing was reviewed")
      prompt_failed=1
      ;;
    *)
      settled+=("DID NOT SETTLE within ${timeout_minutes}m -- may still be working; re-read later")
      prompt_failed=1
      ;;
  esac
done

for ((i = 0; i < count; i++)); do
  printf '%s: %s\n' "${names[$i]}" "${settled[$i]}"
done

read_commands="$(
  for ((i = 0; i < count; i++)); do
    printf 'herdr agent read %s --source recent-unwrapped --lines 100\n' "${names[$i]}"
  done
)"

cat <<INSTRUCTIONS

Read the reviews one at a time (raise --lines or re-read as needed; each report sits at
the end of its pane):

\`\`\`bash
${read_commands}
\`\`\`

Do not pipe these through head/tail; a clipped review is a lost review. Redirect to a
file and read that instead when a report is long.
INSTRUCTIONS

exit "$prompt_failed"

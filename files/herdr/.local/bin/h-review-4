#!/usr/bin/env bash

set -euo pipefail

if (( $# != 4 )); then
  printf 'usage: h-review-4 PROMPT1 PROMPT2 PROMPT3 PROMPT4\n' >&2
  exit 64
fi

# An open-ended prompt can outrun any fixed deadline; raise this rather than lose the run.
timeout_ms="${H_REVIEW_TIMEOUT_MS:-7200000}"
timeout_minutes=$(( timeout_ms / 60000 ))

original_pane_json="$(herdr pane current)"
original_tab_id="$(jq -er '.result.pane.tab_id' <<<"$original_pane_json")"

tabs_json="$(herdr tab list --workspace "$HERDR_WORKSPACE_ID")"
review_tab_id="$(jq -r --arg label reviews \
  'first(.result.tabs[]? | select(.label == $label) | .tab_id) // empty' \
  <<<"$tabs_json")"

if [[ -n "$review_tab_id" ]]; then
  panes_json="$(herdr pane list --workspace "$HERDR_WORKSPACE_ID")"
  mapfile -t old_panes < <(
    jq -r --arg tab_id "$review_tab_id" \
      '.result.panes[]? | select(.tab_id == $tab_id) | .pane_id' \
      <<<"$panes_json"
  )
  if (( ${#old_panes[@]} == 0 )); then
    printf 'reviews tab has no panes\n' >&2
    exit 1
  fi

  # Keep one replacement pane alive while the old panes are closed.
  replacement_json="$(herdr pane split "${old_panes[0]}" \
    --direction right \
    --cwd "$PWD" \
    --no-focus \
    --env SHELL=/bin/bash)"
  root_pane="$(jq -er '.result.pane.pane_id' <<<"$replacement_json")"
  for pane in "${old_panes[@]}"; do
    herdr pane close "$pane" >/dev/null
  done
else
  tab_json="$(herdr tab create \
    --workspace "$HERDR_WORKSPACE_ID" \
    --cwd "$PWD" \
    --label reviews \
    --no-focus \
    --env SHELL=/bin/bash)"
  review_tab_id="$(jq -er '.result.tab.tab_id' <<<"$tab_json")"
  root_pane="$(jq -er '.result.root_pane.pane_id' <<<"$tab_json")"
fi

right_json="$(herdr pane split "$root_pane" \
  --direction right \
  --cwd "$PWD" \
  --no-focus \
  --env SHELL=/bin/bash)"
right_pane="$(jq -er '.result.pane.pane_id' <<<"$right_json")"

bottom_left_json="$(herdr pane split "$root_pane" \
  --direction down \
  --cwd "$PWD" \
  --no-focus \
  --env SHELL=/bin/bash)"
bottom_left_pane="$(jq -er '.result.pane.pane_id' <<<"$bottom_left_json")"

bottom_right_json="$(herdr pane split "$right_pane" \
  --direction down \
  --cwd "$PWD" \
  --no-focus \
  --env SHELL=/bin/bash)"
bottom_right_pane="$(jq -er '.result.pane.pane_id' <<<"$bottom_right_json")"

panes=(
  "$root_pane"
  "$right_pane"
  "$bottom_left_pane"
  "$bottom_right_pane"
)

start_agent() {
  local name="$1"
  local kind="$2"
  local pane="$3"
  shift 3

  local response
  for ((attempt = 1; attempt <= 60; attempt++)); do
    if response="$(herdr agent start "$name" \
      --kind "$kind" \
      --pane "$pane" \
      -- "$@" 2>&1)"; then
      printf '%s\n' "$response"
      return
    fi

    if [[ "$response" != *agent_pane_busy* ]]; then
      printf '%s\n' "$response" >&2
      return 1
    fi

    sleep 1
  done

  printf '%s\n' "$response" >&2
  return 1
}

agent_run_id="$RANDOM"
names=(
  "agent-1-${agent_run_id}"
  "agent-2-${agent_run_id}"
  "agent-3-${agent_run_id}"
  "agent-4-${agent_run_id}"
)

start_agent_helper() {
  if (( $# != 2 )); then
    printf 'usage: start_agent_helper NAME_INDEX claude|pi|codex\n' >&2
    return 64
  fi

  local name_index="$1"
  local kind="$2"
  local -a options

  if [[ ! "$name_index" =~ ^[0-3]$ ]]; then
    printf 'invalid agent name index: %s\n' "$name_index" >&2
    return 64
  fi

  case "$kind" in
    claude)
      options=(--model opus --effort medium --dangerously-skip-permissions --system-prompt '')
      ;;
    pi)
      options=(--model openai-codex/gpt-5.6-luna:max)
      ;;
    codex)
      options=(--yolo --model gpt-5.6-luna -c 'model_reasoning_effort="max"')
      ;;
    *)
      printf 'invalid agent kind: %s\n' "$kind" >&2
      return 64
      ;;
  esac

  start_agent "${names[$name_index]}" "$kind" "${panes[$name_index]}" \
    "${options[@]}"
}

start_agent_helper 0 claude
start_agent_helper 1 claude
start_agent_helper 2 pi
start_agent_helper 3 pi

prompts=("$1" "$2" "$3" "$4")
prompt_pids=()
for i in 0 1 2 3; do
  herdr agent prompt "${names[$i]}" "${prompts[$i]}" --wait --timeout "$timeout_ms" &
  prompt_pids+=("$!")
done

echo "Agents started. Now waiting up to ${timeout_minutes} minutes for completion."

# A laggard must never discard the reviews that did finish, so record each outcome and report
# them all. The panes stay alive either way, so even an unsettled agent is still readable.
prompt_failed=0
settled=()
for i in 0 1 2 3; do
  if wait "${prompt_pids[$i]}"; then
    settled+=("finished")
  else
    settled+=("DID NOT SETTLE within ${timeout_minutes}m -- may still be working; re-read later")
    prompt_failed=1
  fi
done

for i in 0 1 2 3; do
  printf '%s: %s\n' "${names[$i]}" "${settled[$i]}"
done

cat <<INSTRUCTIONS

Read the reviews one at a time (raise --lines or re-read as needed; each report sits at
the end of its pane):

\`\`\`bash
herdr agent read ${names[0]} --source recent-unwrapped --lines 100
herdr agent read ${names[1]} --source recent-unwrapped --lines 100
herdr agent read ${names[2]} --source recent-unwrapped --lines 100
herdr agent read ${names[3]} --source recent-unwrapped --lines 100
\`\`\`

Do not pipe these through head/tail; a clipped review is a lost review. Redirect to a
file and read that instead when a report is long.
INSTRUCTIONS

exit "$prompt_failed"

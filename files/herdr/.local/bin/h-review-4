#!/usr/bin/env bash

set -euo pipefail

if (( $# != 4 )); then
  printf 'usage: h-review PROMPT1 PROMPT2 PROMPT3 PROMPT4\n' >&2
  exit 64
fi

original_pane_json="$(herdr pane current)"
original_tab_id="$(jq -er '.result.pane.tab_id' <<<"$original_pane_json")"

tab_json="$(herdr tab create \
  --workspace "$HERDR_WORKSPACE_ID" \
  --cwd "$PWD" \
  --label reviews \
  --focus)"
review_tab_id="$(jq -er '.result.tab.tab_id' <<<"$tab_json")"
root_pane="$(jq -er '.result.root_pane.pane_id' <<<"$tab_json")"

right_json="$(herdr pane split "$root_pane" \
  --direction right \
  --cwd "$PWD" \
  --no-focus)"
right_pane="$(jq -er '.result.pane.pane_id' <<<"$right_json")"

bottom_left_json="$(herdr pane split "$root_pane" \
  --direction down \
  --cwd "$PWD" \
  --no-focus)"
bottom_left_pane="$(jq -er '.result.pane.pane_id' <<<"$bottom_left_json")"

bottom_right_json="$(herdr pane split "$right_pane" \
  --direction down \
  --cwd "$PWD" \
  --no-focus)"
bottom_right_pane="$(jq -er '.result.pane.pane_id' <<<"$bottom_right_json")"

start_agent() {
  local name="$1"
  local kind="$2"
  local pane="$3"
  shift 3

  local response
  for ((attempt = 1; attempt <= 60; attempt++)); do
    if response="$(herdr agent start "$name" \
      --kind "$kind" \
      --pane "$pane" \
      -- "$@" 2>&1)"; then
      printf '%s\n' "$response"
      return
    fi

    if [[ "$response" != *agent_pane_busy* ]]; then
      printf '%s\n' "$response" >&2
      return 1
    fi

    sleep 1
  done

  printf '%s\n' "$response" >&2
  return 1
}

start_agent claude-review claude "$root_pane" \
  --model opus --effort high --dangerously-skip-permissions
start_agent codex-review-1 codex "$right_pane" \
  --model gpt-5.6-luna -c 'model_reasoning_effort="max"'
start_agent codex-review-2 codex "$bottom_left_pane" \
  --model gpt-5.6-luna -c 'model_reasoning_effort="max"'
start_agent codex-review-3 codex "$bottom_right_pane" \
  --model gpt-5.6-luna -c 'model_reasoning_effort="max"'

prompt_pids=()
herdr agent prompt claude-review "$1" --wait --timeout 2400000 &
prompt_pids+=("$!")
herdr agent prompt codex-review-1 "$2" --wait --timeout 2400000 &
prompt_pids+=("$!")
herdr agent prompt codex-review-2 "$3" --wait --timeout 2400000 &
prompt_pids+=("$!")
herdr agent prompt codex-review-3 "$4" --wait --timeout 2400000 &
prompt_pids+=("$!")
echo Waiting up to 40 minutes for agents to complete

prompt_failed=0
for prompt_pid in "${prompt_pids[@]}"; do
  if ! wait "$prompt_pid"; then
    prompt_failed=1
  fi
done

if (( prompt_failed != 0 )); then
  exit 1
fi

herdr tab focus "$original_tab_id" >/dev/null

cat <<INSTRUCTIONS
All four reviews finished. Their panes are still alive, so read them one at a time
(raise --lines or re-read as needed; each report sits at the end of its pane):

  herdr agent read claude-review --source recent-unwrapped --lines 400
  herdr agent read codex-review-1 --source recent-unwrapped --lines 400
  herdr agent read codex-review-2 --source recent-unwrapped --lines 400
  herdr agent read codex-review-3 --source recent-unwrapped --lines 400

Do not pipe these through head/tail; a clipped review is a lost review. Redirect to a
file and read that instead when a report is long.

Release the panes once every review has been read:

  herdr tab close $review_tab_id
INSTRUCTIONS

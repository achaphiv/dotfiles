#!/usr/bin/env bash

set -euo pipefail

if (( $# == 0 )); then
  printf 'usage: h-change COMMAND...\n' >&2
  exit 64
fi

h-close-old

rm -f -- "$HOME/tmp/h_${HERDR_WORKSPACE_ID}/state.md"

if ! git rebase main; then
  printf 'h-change: rebase onto main failed; resolve the conflicts or run `git rebase --abort`, then rerun\n' >&2
  exit 1
fi

prompt="$*"

rm -r .pi/agents || true
mkdir -p ~/tmp/h_${HERDR_WORKSPACE_ID}
echo "Original request: $prompt" > ~/tmp/h_${HERDR_WORKSPACE_ID}/state.md

the_command=h-main-run-claude
#the_command=h-main-run-pi

exec $the_command \
"$prompt "'

Choose `<TYPE>/<CHANGE_NAME>` (`feat`, `fix`, `refactor`, etc.) and run:

```bash
git checkout -b <TYPE>/<CHANGE_NAME>
herdr workspace rename $HERDR_WORKSPACE_ID <CHANGE_NAME>
```

Implement with commits.

Finally, run: `h-review-this-branch`
'

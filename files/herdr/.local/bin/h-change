#!/usr/bin/env bash

set -euo pipefail

if (( $# == 0 )); then
  printf 'usage: h-change COMMAND...\n' >&2
  exit 64
fi

if ! git rebase main; then
  printf 'h-change: rebase onto main failed; resolve the conflicts or run `git rebase --abort`, then rerun\n' >&2
  exit 1
fi

h-close-old

prompt="$*"

mkdir -p tmp
rm -f -- "./tmp/state.md"
printf 'Original request: %s\n' "$prompt" > ./tmp/state.md

model=openai-codex/gpt-6-sol:high
#model=openai-codex/gpt-6-luna:max

exec h-main-run pi \
"$prompt "'

Choose `<TYPE>/<CHANGE_NAME>` (`feat`, `fix`, `refactor`, etc.) and run:

```bash
git checkout -b <TYPE>/<CHANGE_NAME>
herdr workspace rename $HERDR_WORKSPACE_ID <CHANGE_NAME>
```

Ask questions if unclear.

Once the intention is fully clarified, implement with commits.

Afterwards, run: `h-review-this-branch`
' \
  --model "$model"

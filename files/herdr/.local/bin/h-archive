#!/usr/bin/env bash

set -euxo pipefail

h-close-old

# The optional follow-up is appended to the agent prompt used when the branch cannot merge as
# is; h-merge-auto passes the instruction that loops the agent back into the merge.
if (( $# > 1 )); then
  printf 'usage: h-archive [AGENT_FOLLOW_UP]\n' >&2
  exit 64
fi

follow_up="${1:-}"

branch=$(git branch --show-current)

if [[ -z "$branch" ]]; then
  printf 'h-archive: HEAD is detached; check out the change branch, then rerun\n' >&2
  exit 1
fi

if [[ "$branch" == main ]]; then
  printf 'h-archive: already on `main`; nothing to merge\n' >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  printf 'h-archive: uncommitted changes; commit or stash them, then rerun\n' >&2
  exit 1
fi

# Merging without an agent is only safe while the branch is already on top of main: that is the
# state that was reviewed. Once main has moved, the replayed change is unverified, so hand it to
# an agent whether or not the replay hit conflicts.
if ! git merge-base --is-ancestor main HEAD; then
  if git rebase main; then
    situation='`main` moved, so this branch was replayed onto it and the change needs re-verification.'
  else
    situation='The rebase onto `main` hit conflicts and is still in progress.

Resolve the conflicts and finish the rebase, or run `git rebase --abort` and redo the branch on
top of `main`; prefer amending/rewriting history.'
  fi

  prompt=$(printf '%s\n\n%s\n' "$situation" 'After fixes, run: `h-review-this-branch`')

  if [[ -n "$follow_up" ]]; then
    prompt=$(printf '%s\n\n%s\n' "$prompt" "$follow_up")
  fi

  exec h-main-run-pi "$prompt"
fi

if ! mise run check; then
  h-main-run-pi 'Fix `mise run check`. Make commits. After done, run `h-review-this-branch`'
  exit
fi

mise run test
mise run format && git add -u && git commit -m 'style: `mise run format`' || true

herdr workspace rename $HERDR_WORKSPACE_ID 'AR '$(git symbolic-ref --short HEAD)

#the_command=h-main-run-claude
#the_command=h-main-run-pi

#model=openai-codex/gpt-6-sol:high
model=openai-codex/gpt-6-luna:high

exec h-main-run pi \
'/skill:openspec-archive-change

Always sync specs automatically, without any approval.
Use your own judgement. Avoid asking me questions unless it is a severe issue.

After done:

- Make commits
- Run `h-merge`
' \
  --model "$model"

#!/usr/bin/env bash

set -euo pipefail

# Starts an agent in an existing pane and hands it a prompt over the socket API.

if (( $# < 4 )); then
  printf 'usage: h-agent-run NAME PANE_ID KIND PROMPT [AGENT_ARG...]\n' >&2
  exit 64
fi

name="$1"
pane_id="$2"
kind="$3"
prompt="$4"
shift 4

h-agent-start "$name" "$pane_id" "$kind" "$@"

exec h-agent-prompt "$name" "$pane_id" "$prompt"

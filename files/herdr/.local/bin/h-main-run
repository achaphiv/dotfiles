#!/usr/bin/env bash

set -euo pipefail

if (( $# < 2 )); then
  printf 'usage: h-main-run KIND PROMPT [AGENT_ARG...]\n' >&2
  exit 64
fi

kind="$1"
prompt="$2"
shift 2

tabs_json=$(herdr tab list --workspace "$HERDR_WORKSPACE_ID")
main_tab_id=$(jq -r --arg label main \
  'first(.result.tabs[]? | select(.label == $label) | .tab_id) // empty' \
  <<<"$tabs_json")

mkdir -p "$HOME/tmp/"

if [[ -n "$main_tab_id" ]]; then
  panes_json=$(herdr pane list --workspace "$HERDR_WORKSPACE_ID")
  parent_pane_id=$(jq -er --arg tab_id "$main_tab_id" \
    'first(.result.panes[]? | select(.tab_id == $tab_id) | .pane_id)' \
    <<<"$panes_json")

  # Always use a fresh sibling: the existing pane may still be occupied by the caller's agent.
  pane_json=$(herdr pane split "$parent_pane_id" \
    --direction down \
    --cwd "$PWD" \
    --no-focus \
    --env SHELL=/bin/bash \
    --env "TMPDIR=$HOME/tmp/")
  pane_id=$(jq -er '.result.pane.pane_id' <<<"$pane_json")
else
  # The agent inherits SHELL from the pane shell. Pinning bash keeps both off fish, whose
  # quoting rules differ enough to mangle prompts.
  tab_json=$(herdr tab create \
    --workspace "$HERDR_WORKSPACE_ID" \
    --cwd "$PWD" \
    --label main \
    --no-focus \
    --env SHELL=/bin/bash \
    --env "TMPDIR=$HOME/tmp/")

  pane_id=$(jq -er '.result.root_pane.pane_id' <<<"$tab_json")
fi

exec h-agent-run "main-$RANDOM" "$pane_id" "$kind" "$prompt" "$@"

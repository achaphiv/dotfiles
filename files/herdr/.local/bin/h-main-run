#!/usr/bin/env bash

set -euo pipefail

if (( $# < 2 )); then
  printf 'usage: h-main-run KIND PROMPT [AGENT_ARG...]\n' >&2
  exit 64
fi

kind="$1"
prompt="$2"
shift 2

tab_list_json=$(herdr tab list --workspace "$HERDR_WORKSPACE_ID")

while read -r tab_id; do
  herdr tab close "$tab_id"
done < <(
  jq -r '.result.tabs[] | select(.label == "main") | .tab_id' <<<"$tab_list_json"
)

# The agent inherits SHELL from the pane shell. Pinning bash keeps both off fish, whose
# quoting rules differ enough to mangle prompts.
tab_json=$(herdr tab create \
  --workspace "$HERDR_WORKSPACE_ID" \
  --cwd "$PWD" \
  --label main \
  --no-focus \
  --env SHELL=/bin/bash)

pane_id=$(jq -er '.result.root_pane.pane_id' <<<"$tab_json")

exec h-agent-run "main-$RANDOM" "$pane_id" "$kind" "$prompt" "$@"

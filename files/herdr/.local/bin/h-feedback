#!/usr/bin/env bash

set -euo pipefail

if (( $# == 1 )) && [[ $1 == --help ]]; then
  cat <<'HELP'
usage: h-feedback PROMPT...
       h-feedback --help

Delegate a fix or other implementation task to a fresh LLM agent in a new Herdr tab.

The prompt is passed to a `pi` agent running in the current working directory. The command
creates a tab labeled `feedback-N` without focusing it, then appends:

  Run `h-implement` and follow its instructions.

The agent is expected to implement the task, commit its changes, and use `h-implement`'s
review/feedback workflow. `HERDR_WORKSPACE_ID`, `herdr`, and `jq` are required.
HELP
  exit 0
fi

if (( $# == 0 )); then
  printf 'usage: h-feedback PROMPT...\n' >&2
  exit 64
fi

tabs_json=$(herdr tab list --workspace "$HERDR_WORKSPACE_ID")

# Reuse the highest existing feedback-N so a new tab never collides with a live one.
next_index=$(jq -er '
  [.result.tabs[]?.label // empty
   | capture("^feedback-(?<n>[0-9]+)$").n
   | tonumber]
  | (max // 0) + 1
' <<<"$tabs_json")

# The agent inherits SHELL from the pane shell. Pinning bash keeps both off fish, whose
# quoting rules differ enough to mangle prompts.
tab_json=$(herdr tab create \
  --workspace "$HERDR_WORKSPACE_ID" \
  --cwd "$PWD" \
  --label "feedback-${next_index}" \
  --no-focus \
  --env SHELL=/bin/bash)

pane_id=$(jq -er '.result.root_pane.pane_id' <<<"$tab_json")

prompt=$(printf '%s\n\n%s\n' "$*" 'Run `h-implement` and follow its instructions.')

exec h-agent-run "feedback-${next_index}-$RANDOM" "$pane_id" claude "$prompt" \
  --dangerously-skip-permissions --system-prompt ''
